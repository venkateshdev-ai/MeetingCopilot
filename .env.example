# ============================================================
# Meeting Optimization Copilot — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ── AI / LLM Provider ────────────────────────────────────────
# OpenAI API key (required for RAG pipeline)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Use a different model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# ── Vector Store / Embeddings ────────────────────────────────
# If using a vector DB for RAG (e.g., Pinecone, Weaviate, Supabase)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX=your_index_name
# PINECONE_ENVIRONMENT=your_environment

# ── App Config ───────────────────────────────────────────────
# Next.js public URL (used for API routes in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: Analytics ──────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
